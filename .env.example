# Optional overrides; the pinned 0.1.45 Strata files need no .env on VM205.
# Never commit secrets.
MODEL_DIR=../../models
NINFER_BIND_ADDRESS=127.0.0.1
NINFER_PORT=8080
# Strata defaults to VM205's NetBird address, with no API key.
# On another host override the bind address (e.g. 127.0.0.1) and data directory.
STRATA_BIND_ADDRESS=100.0.0.159
STRATA_PORT=8080
STRATA_DATA_DIR=/opt/models
# Required by compose.022.yaml and compose.orca.yaml (0.2.2 always enforces
# authentication) and optional for the pinned 0.1.45 files. Set it before first
# setup; never expose the keyless 0.1.45 API outside NetBird.
STRATA_API_KEY=
# Extra Host names the keyless API answers to besides IPs and localhost
# (comma-separated, e.g. comfy-vm.netbird.selfhosted). Without a listed name
# or an API key, requests by name get 403 DNS-rebinding protection.
# Changing this needs a container restart (the value is read at server start).
STRATA_ALLOWED_HOSTS=

# Maya / GLM-5.3-Flash: exclusive alternative to Strata on the same GPU.
MAYA_BIND_ADDRESS=100.0.0.159
MAYA_PORT=8080
MAYA_DATA_DIR=/opt/models/maya
# Default: tested 256K/FP16 DFlash2 profile; drafter requires noncommercial use.
# For ordinary decode instead, select this profile and explicitly reinstall:
# MAYA_PROFILE=../../configs/maya-glm53-flash-m-derisked-4090.env
# NetBird-only by default; set a key before exposing to any other network.
MAYA_API_KEY=
