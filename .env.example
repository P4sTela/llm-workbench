# Copy to .env; keep host-specific values and secrets out of Git.
MODEL_DIR=../../models
NINFER_BIND_ADDRESS=127.0.0.1
NINFER_PORT=8080
# Strata is the canonical runtime. Loopback is safe by default; for VM205 use
# STRATA_BIND_ADDRESS=100.0.0.159 so the API is reachable only over NetBird.
STRATA_BIND_ADDRESS=127.0.0.1
STRATA_PORT=8080
STRATA_DATA_DIR=../../models/strata-data
# Set before first setup when publishing beyond loopback; never commit this value.
STRATA_API_KEY=
