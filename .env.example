# Optional overrides; Strata needs no .env on VM205. Never commit secrets.
MODEL_DIR=../../models
NINFER_BIND_ADDRESS=127.0.0.1
NINFER_PORT=8080
# Strata defaults to VM205's NetBird address, with no API key.
# On another host override the bind address (e.g. 127.0.0.1) and data directory.
STRATA_BIND_ADDRESS=100.0.0.159
STRATA_PORT=8080
STRATA_DATA_DIR=/opt/models
# Optional: set before first setup; never expose the keyless API outside NetBird.
STRATA_API_KEY=

# Maya / GLM-5.3-Flash: exclusive alternative to Strata on the same GPU.
MAYA_BIND_ADDRESS=100.0.0.159
MAYA_PORT=8080
MAYA_DATA_DIR=/opt/models/maya
# Default: tested 256K/FP16 DFlash2 profile; drafter requires noncommercial use.
# For ordinary decode instead, select this profile and explicitly reinstall:
# MAYA_PROFILE=../../configs/maya-glm53-flash-m-derisked-4090.env
# NetBird-only by default; set a key before exposing to any other network.
MAYA_API_KEY=
