# llama.cpp / RadixArk DaisyRose-27B (Q4_K_XL) / RTX 4090
# RL-only agent fine-tune of Qwen3.8-27B (~1,200 long-horizon agent tasks).
# Same architecture, tokenizer and chat template as the base model, so this is
# a drop-in swap against llamacpp-qwen38-27b-4090-base.env. GPU validation
# pending; the card's benchmark gains are the vendor's own numbers.
MODEL_FILE=daisyrose-27b/DaisyRose-27B-Q4_K_XL.gguf
MODEL_ALIAS=daisyrose-27b
CTX=131072
NGL=99
PARALLEL=1
KV_K=q8_0
KV_V=q8_0
FLASH_ATTN=on
# The GGUF carries the MTP head (blk.64.nextn.*). llama.cpp loads it only
# when a spec type asks for it, so without this flag the tensors are
# reported as unused and decode runs at the plain 44-48 t/s.
EXTRA_ARGS=--spec-type draft-mtp --temp 1.0 --top-p 0.95
