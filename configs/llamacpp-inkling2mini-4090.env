# llama.cpp / Thinking Machines Lab Inkling 2 Mini (Unsloth UD-Q4_K_XL) / RTX 4090
# 26.4B looped MoE, 3.4B active per token (5.4B with the three loop passes).
# Alternative to Strata's SQ-20 pack for the same model: no Strata 0.2.19
# source build needed, and the same llama.cpp service as the 27B arms.
# GPU validation pending. Thinking cannot be fully disabled on this model.
MODEL_FILE=inkling-2-mini/Inkling-2-Mini-UD-Q4_K_XL.gguf
MODEL_ALIAS=inkling-2-mini
# 32768 first: the model advertises 1M context, but 17.6 GB of weights leaves
# little room on a 24 GB card. Raise in steps and watch for allocation failure.
CTX=32768
NGL=99
PARALLEL=1
KV_K=q8_0
KV_V=q8_0
FLASH_ATTN=on
EXTRA_ARGS=--temp 1.0 --top-p 0.95
