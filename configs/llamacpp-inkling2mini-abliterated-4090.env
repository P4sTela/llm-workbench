# llama.cpp / orcarouter Inkling 2 Mini abliterated (Mix-16G) / RTX 4090
# Text only (no vision, no MTP). Needs llama.cpp b12633 or later: start with
# LLAMA_IMAGE set to a newer server-cuda digest (see notes); the default pin
# (build 12627) predates it. Tested: server-cuda@sha256:f8e7c336... (build 12648).
MODEL_FILE=inkling-2-mini-abliterated/Inkling-2-Mini-abliterated-Mix-16G.gguf
MODEL_ALIAS=inkling-2-mini-abliterated
CTX=65536
NGL=99
PARALLEL=1
KV_K=q8_0
KV_V=q8_0
FLASH_ATTN=on
EXTRA_ARGS=--temp 1.0 --top-p 0.95
# 131072 fails: the compute buffer alone wants 12.9 GB. 65536 runs at 22.8 GB.
# Keep every expert in VRAM (llama.cpp issue #32710).
