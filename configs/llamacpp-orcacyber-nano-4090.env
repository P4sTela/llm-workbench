# llama.cpp / OrcaRouter OrcaCyber Nano 1.0 (Mix-15.7G) / RTX 4090
# Qwen3.8-27B fine-tune for cyber defense. Same architecture as the base
# profile, so the same context, KV and MTP settings apply. The file is the
# one orcarouter publishes on Ollama (registry blob sha256:4214beb4...), byte
# for byte the HF Mix-15.7G (the HF repo is gated).
MODEL_FILE=orcacyber-nano-1.0/OrcaCyber-Nano-1.0-AI-Defense-Mix-15.7G.gguf
MODEL_ALIAS=orcacyber-nano-1.0
CTX=131072
NGL=99
PARALLEL=1
KV_K=q8_0
KV_V=q8_0
FLASH_ATTN=on
# MTP head is in the file; card-recommended sampling.
EXTRA_ARGS=--spec-type draft-mtp --temp 1.0 --top-p 0.95 --top-k 20
