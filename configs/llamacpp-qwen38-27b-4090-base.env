# llama.cpp / Qwen3.8-27B base (Unsloth UD-Q4_K_XL) / RTX 4090
# Reference arm for the agent-weight comparison: same quantization family as
# the DaisyRose profile, same engine, same context. GPU validation pending.
# The model keeps Qwen3.8's own chat template; --jinja is required for tools.
MODEL_FILE=qwen3.8-27b/Qwen3.8-27B-UD-Q4_K_XL.gguf
MODEL_ALIAS=qwen3.8-27b-base
# 131072 keeps KV inside the ~6 GiB left after 17.7 GB of weights; lower to
# 65536 if the first request fails to allocate.
CTX=131072
NGL=99
PARALLEL=1
KV_K=q8_0
KV_V=q8_0
FLASH_ATTN=on
# Recommended sampling from the model card for agentic use.
EXTRA_ARGS=--temp 1.0 --top-p 0.95
