# Strata 0.2.19 / Thinking Machines Lab Inkling 2 Mini SQ-20 / RTX 4090
# Used by docker/strata/compose.inkling.yaml. SQ-20 (19.35 GB) is the
# bit-exact lossless pack and fits the 24 GiB card fully. DSpark drafting
# (W=4 Markov beam tree) is built into the strata-inkling shape engine.
FAMILY=inkling-2-mini
MODEL=SQ-20
CONTEXT=128k
PARALLEL=1
VISION=gpu
KV=int8
TUNE=skip
PRESET=inkling-sq20
