# Strata 0.2.2 / Qwen3.8-Flash-Next UD-Q4_K_XL / RTX 4090 / 512K context
# Used by docker/strata/compose.022.yaml. 0.2.2 reads the same variable names;
# 0.1.x-only options (LOW_RAM, RESIDENT_BUDGET_GIB, ...) are ignored.
FAMILY=unsloth
MODEL=UD-Q4_K_XL
# Past the model's trained 262144, so the launch adds yarn scaling.
CONTEXT=524288
VISION=on
KV=int8
GPU=0
# 0.2.2 ignores the 0.1.x RESIDENT_BUDGET_GIB variable; engine settings go
# through STRATA_SET. 80 GiB keeps the UD-Q4_K_XL experts resident in RAM.
# 960 MiB VRAM reserve is the engine's advice for this card (#2065); at 700
# a request start logged only ~290 MiB free.
STRATA_SET=resident-budget-gib=80 vram-reserve-mib=1024
# One slot: 0.2.2 fits 3 slots by default, and their session memory takes
# ~4.2 GiB of VRAM from the expert cache (4716 -> 3222 slots on this card).
PARALLEL=1
