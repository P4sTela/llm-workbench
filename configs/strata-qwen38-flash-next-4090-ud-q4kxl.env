# Strata v0.1.45 / Qwen3.8-Flash-Next UD-Q4_K_XL / RTX 4090 (VM205)
# Use compose.iq4xs.yaml with STRATA_PROFILE pointing here; stop the UD-IQ4_XS service
# first (same GPU and NetBird port 8080).
FAMILY=unsloth
MODEL=UD-Q4_K_XL
CONTEXT=262144
VISION=yes
# Empty keeps setup.py's default int8 KV cache.
KV=
GPU=0
LOW_RAM=auto
# UD-Q4_K_XL keeps 71.7 GiB of experts in RAM; 224 GiB host RAM leaves room for 80.
RESIDENT_BUDGET_GIB=80
