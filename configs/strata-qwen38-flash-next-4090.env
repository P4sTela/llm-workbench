# Strata / Qwen3.8-Flash-Next / RTX 4090 (VM205) — quality profile
# Read by docker-entrypoint.sh. Values are the setup choices recorded in
# /data/config/strata-<model>.json on first start.
#
# Model size: IQ3_S is the largest Strata size ("matches the full model on the
# published tests"). It needs ~55 GB of RAM+VRAM combined, so it fits on VM205
# (224 GiB RAM) with the experts fully in RAM; on 64 GB hosts prefer IQ2_XS
# (configs/strata-qwen38-flash-next-4090-iq2xs.env).
FAMILY=qwen
MODEL=IQ3_S
# 131072 keeps parity with the llama.cpp Flash-Next sub profile (-c 131072)
# for the A/B comparison on VM205.
CONTEXT=131072
# no | yes | cpu — the image encoder; off for the first A/B (the llama.cpp
# profile enables mmproj, so VISION=yes is the parity variant).
VISION=no
# int8 | q4_0 | k8v4 — empty keeps setup.py's own default (int8).
KV=
# pin one card (VM205 has a single 4090; without GPU/GPUS the entry point
# would offer a layer split when two cards are visible)
GPU=0
LOW_RAM=auto
