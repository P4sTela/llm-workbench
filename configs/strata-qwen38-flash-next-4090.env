# Strata / Qwen3.8-Flash-Next / RTX 4090 (VM205) — main profile
# Single default profile for ordinary use, not an A/B variant.
FAMILY=qwen
MODEL=IQ3_S
# Balanced 128K context for the 24 GB GPU; model-native maximum is 262144.
CONTEXT=131072
# Enable the image encoder for multimodal use.
VISION=yes
# int8 | q4_0 | k8v4 — empty keeps setup.py's default (int8).
KV=
# VM205 has one RTX 4090; pin it explicitly.
GPU=0
LOW_RAM=auto
